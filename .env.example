# ---------------------------------------------------------------------------
# CrazyCauldron - copy to .env and fill in.
#
# Read once at startup. Only VITE_-prefixed vars ever reach a browser, which is
# why every secret below deliberately lacks that prefix: RPC_URL, JWT_SECRET,
# DATABASE_URL and ADMIN_TOKEN must never ship in a bundle.
#
# On Colyseus Cloud there is no .env file - the same names go in the dashboard's
# environment variables. See DEPLOY.md.
# ---------------------------------------------------------------------------

# "development" | "production". Production refuses to start if anything below
# is set the way it would be on a laptop; see DEPLOY.md for the whole list.
NODE_ENV=development

# --- Server ----------------------------------------------------------------
# Colyseus + Express listen port. Ignored on Colyseus Cloud, which assigns one.
PORT=2567
# Comma-separated origins allowed to call /auth and /play. A request from the
# page this server itself served is always allowed, whatever this says.
CORS_ORIGIN=http://localhost:5173

# --- Auth (Sign-In With Solana) --------------------------------------------
# Secret used to sign the 1-hour session JWTs. CHANGE THIS - any random 32+
# byte string. Rotating it invalidates every issued token.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# Domain + URI embedded in the sign-in message the wallet displays.
SIWS_DOMAIN=localhost:5173
SIWS_URI=http://localhost:5173

# Per-IP budget shared by /auth/nonce and /auth/verify. Raise it only to run
# scripts/loadtest.ts, which signs in many wallets from a single address.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000

# --- Solana / token gate ---------------------------------------------------
# RPC endpoint used for balance checks. NEVER exposed to the client.
RPC_URL=https://api.devnet.solana.com
# SPL mint of $COOK. PLACEHOLDER - replace at launch. This is also the address
# /official publishes for players to copy, so it must be the real one.
COOK_MINT=So11111111111111111111111111111111111111112
# Minimum $COOK (UI amount, decimal-adjusted) required to enter the hub.
MIN_HOLD=2000
# Skips the balance check entirely. DEVELOPMENT ONLY - the server refuses to
# boot with this set to true while NODE_ENV=production.
TEST_BYPASS_HOLD=true

# --- Database --------------------------------------------------------------
# Set DATABASE_URL and the server runs on Postgres; leave it unset and it runs
# on the SQLite file below. That is the only switch - there is no third
# setting, and no way to be on one backend while configured for the other.
#
# Anywhere the filesystem is not yours - Colyseus Cloud included - use
# Postgres. A container that is replaced on deploy takes the SQLite file with
# it, and nobody notices until every player has started again.
# DATABASE_URL=postgres://user:password@host:5432/crazycauldron

# better-sqlite3 file path, relative to the repo root. ":memory:" also works.
DATABASE_PATH=./data/crazycauldron.db

# --- Capacity --------------------------------------------------------------
# Players per HubRoom; a new hub is created when the newest one fills.
HUB_MAX_PLAYERS=30
# Global concurrent players before new joiners are sent to the WaitingRoom.
GLOBAL_MAX_PLAYERS=300

# --- The public pages ------------------------------------------------------
# Served by /public/config and shown on /official. The contract address a
# player copies comes from COOK_MINT above, at request time, so it is always
# the address the running deployment actually gates on.
PUBLIC_DOMAIN=crazycauldron.art
# "none" is a real answer, and a better one than silence: "we have no X
# account" is useful, and silence is what a fake account fills.
SOCIAL_X=none
SOCIAL_TELEGRAM=none

# --- The $COOK shop (dormant) ----------------------------------------------
# Leave false. Every shop route answers 404 while it is, and the server refuses
# to start in production with it true and no treasury.
SHOP_ENABLED=false
# Where the half that is not burned goes. Required once SHOP_ENABLED is true.
TREASURY_WALLET=CTjcrsrKUTbEbm91XbL1BToD3cUEJcjxNvyeuW2nd8LU

# --- The rollback switch ---------------------------------------------------
# true closes entry with a friendly message while /health stays up. Only a
# seed: once the switch has been flipped by hand it is the stored value that
# decides, so a restart does not reopen a hub that was closed for a reason.
MAINTENANCE=false
# Bearer token for POST /admin/maintenance. Unset and the route returns 404 -
# an admin endpoint secured by an empty string is worse than none.
# ADMIN_TOKEN=a-long-random-string-nobody-can-guess

# --- Client (Vite - these ARE public) --------------------------------------
# These are for the dev server only, and a production build ignores them: the
# bundle is compiled with both pinned to empty, so the client always asks
# whatever origin served the page.
#
# That pinning exists because of a real outage. The built client is committed
# now, so it is made on a developer's machine - where these say localhost - and
# without the pin those values shipped to production and the deployed client
# tried to sign people in against their own laptop.
VITE_SERVER_HTTP_URL=http://localhost:2567
VITE_SERVER_WS_URL=ws://localhost:2567

# --- Monitoring and backups ------------------------------------------------
# Rotating JSON log. Also written to stdout.
LOG_DIR=./logs
LOG_MAX_BYTES=5242880
LOG_GENERATIONS=5
# Nightly backup, server local time. Copies land in BACKUP_DIR - a SQLite file
# on SQLite, a gzipped logical dump on Postgres.
BACKUP_CRON=0 4 * * *
BACKUP_DIR=./backups
# A second directory each backup is copied to. Unset to keep one copy.
# On Colyseus Cloud point this somewhere that outlives the container, or pull
# the backups off it - the local disk is not a place to keep them.
# BACKUP_DEST=/mnt/offsite/crazycauldron
# POSTed to on unhandled errors and failed health checks. Unset to disable.
# ALERT_WEBHOOK_URL=https://hooks.example.com/crazycauldron
ALERT_COOLDOWN_MS=300000
# How often the server probes its own health.
HEALTH_CHECK_MS=60000
