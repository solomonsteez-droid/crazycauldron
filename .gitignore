node_modules/
dist/
# The built client is committed. Bundling it needs about 1 GB and the deploy
# host has that in total, so the host checks the committed build instead of
# making one - see scripts/build-client.mjs and DEPLOY.md.
!/client/dist/
.env
*.db
*.log
.DS_Store
*.db-shm
*.db-wal
data/
backups/
logs/
*.replaced-*
scripts/tmp-*
scripts/preview/

# The inbox is where dropped art lands before it is processed; the
# processed copy is what the repo keeps.
art/inbox/
